# Material TLS dan nilai environment bersifat runtime-only. Jangan simpan atau
# commit material ini; gunakan secret injection yang disetujui saat runtime.
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
.env
*.env
secrets/

# Output lokal validator dan tooling tidak menjadi source repository.
.validation/
.artifacts/
.ansible/
libpod/
inventory.ini
*.retry

# Proteksi inventori privat untuk keamanan repositori publik
# Hanya inventories/lab.ini dan *.ini.example yang boleh masuk ke Git publik
inventories/*.ini
!inventories/lab.ini
inventories/*.local.ini
inventories/corporate*.ini
inventories/external/
*.local.ini

