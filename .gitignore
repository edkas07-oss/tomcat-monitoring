# TLS materials and runtime-only environment values. Do not commit these files;
# use approved runtime secret injection.
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
.env
*.env
secrets/

# Local validator outputs, cache, and tooling artifacts
.validation/
.artifacts/
.ansible/
libpod/
inventory.ini
*.retry

# Private inventory and configuration protection for repository safety
# Only inventories/lab.ini and *.ini.example are tracked in Git
CONFIG.local
*.local
*.local.*
inventories/*.ini
!inventories/lab.ini
inventories/*.local.ini
inventories/corporate*.ini
inventories/external/
*.local.ini
*.exe
roles/role_container_stack/files/
/${HOME}/


