# Staging Environment Inventory for Tomcat Monitoring
[monitoring_core]
mon-stg-01.internal ansible_host=10.10.20.10 ansible_user=ansible

[tomcat_fleet]
tomcat-stg-01.internal ansible_host=10.10.20.21 ansible_user=ansible
tomcat-stg-02.internal ansible_host=10.10.20.22 ansible_user=ansible

[all:children]
monitoring_core
tomcat_fleet

[all:vars]
deploy_env=staging
container_engine=podman
