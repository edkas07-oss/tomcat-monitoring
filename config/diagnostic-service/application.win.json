{
  "schemaVersion": 1,
  "listen": {
    "host": "0.0.0.0",
    "port": 8443
  },
  "databasePath": "C:\\var\\lib\\tomcat-diagnostic\\diagnostic.db",
  "tls": {
    "certificateFile": "C:\\monitoring\\tls\\server.crt",
    "privateKeyFile": "C:\\monitoring\\tls\\server.key"
  },
  "bearerTokenFile": "C:\\monitoring\\secrets\\bearer-token",
  "targetAllowlistFile": "C:\\monitoring\\config\\diagnostic-service\\targets.json",
  "smtp": {
    "host": "mailpit",
    "port": 1025,
    "secure": false,
    "requireTLS": false,
    "from": "diagnostic@tomcat-monitoring.invalid",
    "to": "operator@tomcat-monitoring.invalid"
  },
  "prometheus": {
    "baseUrl": "http://prometheus:9090"
  },
  "queue": {
    "capacity": 50,
    "pollIntervalMs": 250,
    "staleLockTimeoutMs": 300000,
    "maxRetries": 3,
    "retentionDays": 30,
    "housekeepingIntervalMs": 86400000
  },
  "timeouts": {
    "diagnosticMs": 60000,
    "smtpMs": 10000,
    "shutdownMs": 10000,
    "prometheusMs": 5000
  },
  "requestLimitBytes": 262144
}
