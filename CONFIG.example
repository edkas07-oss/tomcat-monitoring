# Declarative Configuration Example for Enterprise Container Registry (Harbor / Nexus / Quay)
#
# Copy this file to CONFIG or adjust the environment variables below
# before executing monitoring stack deployment automation.

# 0. Enterprise Container Registry Baseline
REGISTRY_URL="harbor.internal.corp:5000"
REGISTRY_NAMESPACE="tomcat-monitoring"
REGISTRY_TLS_VERIFY="true"
IMAGE_PULL_POLICY="Always"
REGISTRY_AUTH_FILE="${HOME}/.config/containers/auth.json"

# 1. Platform & Network Identifiers
PLATFORM_NAME="tomcat-monitoring"
NETWORK_NAME="${CONTAINER_NETWORK:-${NETWORK_NAME:-tm-net}}"

# 2. Container Runtime Identifiers
TOMCAT_CONTAINER="tomcat-jmx-exporter"
PROMETHEUS_CONTAINER="prometheus"
ALERTMANAGER_CONTAINER="alertmanager"
DIAGNOSTIC_CONTAINER="diagnostic-service"
POSTFIX_CONTAINER="postfix-relay"
MAILPIT_CONTAINER="mailpit"

# 3. Container Images & Dynamic Enterprise Registry References
TOMCAT_JMX_IMAGE="${REGISTRY_URL}${REGISTRY_NAMESPACE:+/${REGISTRY_NAMESPACE}}/tomcat-jmx-exporter:1.0.0"
PROMETHEUS_IMAGE="${REGISTRY_URL}${REGISTRY_NAMESPACE:+/${REGISTRY_NAMESPACE}}/prometheus:1.0.0"
ALERTMANAGER_IMAGE="${REGISTRY_URL}${REGISTRY_NAMESPACE:+/${REGISTRY_NAMESPACE}}/alertmanager:1.0.0"
DIAGNOSTIC_IMAGE="${REGISTRY_URL}${REGISTRY_NAMESPACE:+/${REGISTRY_NAMESPACE}}/tomcat-diagnostic-service:latest"
NODEJS_IMAGE="${REGISTRY_URL}${REGISTRY_NAMESPACE:+/${REGISTRY_NAMESPACE}}/nodejs:24.18.0"
MAILPIT_IMAGE="ghcr.io/axllent/mailpit:v1.31.0@sha256:c96991d9bef73594c246d89ca81411d4e916f03e76a7d2d72fa2ab5dd3c9ce24"
POSTFIX_IMAGE="${REGISTRY_URL}${REGISTRY_NAMESPACE:+/${REGISTRY_NAMESPACE}}/postfix-relay:latest"

# 4. Host & Container Port Bindings
TOMCAT_HTTP_PORT=8083
TOMCAT_JMX_PORT=9404
PROMETHEUS_PORT=9090
ALERTMANAGER_PORT=9093
DIAGNOSTIC_PORT=8443
MAILPIT_HTTP_PORT=8025
MAILPIT_SMTP_PORT=1025
POSTFIX_PORT=587
TELEGRAF_PORT=9273

# 5. Named Volumes Baseline
TOMCAT_LOG_VOLUME="tomcat_logs"
DIAGNOSTIC_DATA_VOLUME="diagnostic_data"
PROMETHEUS_CONFIG_VOLUME="prometheus_config"
PROMETHEUS_TRUSTSTORE_VOLUME="prometheus_truststore"
PROMETHEUS_DATA_VOLUME="prometheus_data"
ALERTMANAGER_CONFIG_VOLUME="alertmanager_config"
ALERTMANAGER_TRUSTSTORE_VOLUME="alertmanager_truststore"
ALERTMANAGER_DATA_VOLUME="alertmanager_data"

# 6. Persistent Host Directories (0700 Strict Permissions)
TM_ROOT_DIR="${TM_ROOT_DIR:-}" # Custom root directory (e.g. C:\tm_data on Windows, /tm_data on Linux)
DEFAULT_SPOOL_DIR="${TM_ROOT_DIR:+${TM_ROOT_DIR}/spool}"
DEFAULT_SPOOL_DIR="${DEFAULT_SPOOL_DIR:-${HOME}/.local/share/tomcat-monitoring/spool}"
DEFAULT_SECRETS_DIR="${TM_ROOT_DIR:+${TM_ROOT_DIR}/secrets}"
DEFAULT_SECRETS_DIR="${DEFAULT_SECRETS_DIR:-${HOME}/.local/share/tomcat-monitoring/diagnostic-service-secrets}"
DEFAULT_TLS_DIR="${TM_ROOT_DIR:+${TM_ROOT_DIR}/tls}"
DEFAULT_TLS_DIR="${DEFAULT_TLS_DIR:-${HOME}/.local/share/tomcat-monitoring/diagnostic-service-tls}"
DEFAULT_JMX_TLS_DIR="${TM_ROOT_DIR:+${TM_ROOT_DIR}/jmx-tls}"
DEFAULT_JMX_TLS_DIR="${DEFAULT_JMX_TLS_DIR:-${HOME}/.local/share/tomcat-monitoring/jmx-exporter-tls}"

# 7. Platform-Wide Threshold & Governance Baseline
DEFAULT_PROMETHEUS_RETENTION_TIME="15d"
DEFAULT_MAX_SPOOL_AGE_HOURS=24
DEFAULT_MAX_SPOOL_FILES=1000
DEFAULT_STALE_TMP_AGE_MINUTES=60
DEFAULT_PROMETHEUS_SCRAPE_INTERVAL="30s"
DEFAULT_PROMETHEUS_SCRAPE_TIMEOUT="10s"
DEFAULT_ALERT_RESOLVE_TIMEOUT="5m"
DEFAULT_ALERT_REPEAT_INTERVAL="4h"

# 8. Deployment Topology & Granular Component Selection
DEPLOY_TOPOLOGY="all_in_one" # all_in_one | monitoring_node | central_hub | custom
SELECTED_COMPONENTS="all"    # all | comma-separated list: prometheus,alertmanager,diagnostic_service,mailpit,tm_agent,tomcat

# 9. TLS Lifecycle Governance & Custom SSL Certificates
TLS_MODE="auto"              # auto (self-signed with auto-renewal) | custom (user-supplied certificates)
TLS_RENEW_THRESHOLD_DAYS="30"
CUSTOM_TLS_CERT_PATH=""
CUSTOM_TLS_KEY_PATH=""
CUSTOM_JMX_TLS_CERT_PATH=""
CUSTOM_JMX_TLS_KEY_PATH=""

# 10. Container Engine Override (Optional: podman / docker)
CONTAINER_ENGINE="podman"

# 11. Local Environment Overrides (Git-ignored)
_CFG_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [[ -f "${_CFG_DIR}/CONFIG.local" ]]; then
    # shellcheck source=/dev/null
    source "${_CFG_DIR}/CONFIG.local"
fi

unset _CFG_DIR

